# Copy to .env for a local run. Never commit real values.
# GitHub Actions secret names match these variable names.
# The GitHub token cannot be named GITHUB_*: Actions rejects those secret names,
# and it already injects GITHUB_TOKEN, which cannot read the XDLAB-AI org.

# Fine-grained PAT or classic PAT with read access to org XDLAB-AI.
# Fine-grained: Contents Read, Metadata Read, Pull requests Read.
GH_READONLY_TOKEN=

# Optional. GitLab group access token or PAT for https://gitlab.com/vgh-code/XdLabsAI-G42
# (full path vgh-code/XdLabsAI-G42, including subgroups).
# Scopes: read_api, read_repository. Role: Reporter.
# Leave unset to skip GitLab. A bad token still fails the run.
GITLAB_TOKEN=

# Anthropic API key. The model id lives in config/default.yaml (llm.model).
ANTHROPIC_API_KEY=

# Slack bot token. Scopes: chat:write, files:write, im:write, im:history, channels:history.
SLACK_BOT_TOKEN=
