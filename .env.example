# Copy to .env for a local run. Never commit real values.
# GitHub Actions secret names are the same as these variable names,
# except the GitHub token secret is GITHUB_TOKEN_READONLY
# (Actions already injects its own GITHUB_TOKEN, which cannot read XDLAB-AI).

# Fine-grained PAT or classic PAT with read access to org XDLAB-AI.
# Fine-grained: Contents Read, Metadata Read, Pull requests Read.
GITHUB_TOKEN_READONLY=

# GitLab group access token or PAT for vgh-code/XdLabsAI-G42-AppBuilder.
# Scopes: read_api, read_repository. Role: Reporter.
GITLAB_TOKEN=

# Anthropic API key. The model id lives in config/default.yaml (llm.model).
ANTHROPIC_API_KEY=

# Slack bot token. Scopes: chat:write, files:write, im:write, im:history, channels:history.
SLACK_BOT_TOKEN=
